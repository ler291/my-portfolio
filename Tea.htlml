<!DOCTYPE html>
<html lang="tl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TeaKoTo Langkiwa - Premium Milk Tea</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;700;800&display=swap');
    :root{--pink:#ff2d75;--purple:#7b2ff7;--bg:#0a0a14;--card:rgba(255,255,255,0.06);--text:#fff;--muted:#999;--green:#00e676}
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text)}
    body::before{content:'';position:fixed;top:0;left:0;width:100%;height:100%;background:radial-gradient(circle at 20% 50%,var(--pink) 0%,transparent 50%),radial-gradient(circle at 80% 80%,var(--purple) 0%,transparent 50%);opacity:.15;z-index:-1}
  .header{background:linear-gradient(135deg,var(--pink),var(--purple));padding:50px 20px 70px;text-align:center;clip-path:ellipse(120% 100% at 50% 0%)}
  .header h1{font-size:3.5rem;font-weight:800;text-shadow:0 0 30px rgba(255,255,255,0.6)}
  .header p{margin:8px 0;opacity:.95;font-size:1.1rem}
  .store-status{position:absolute;top:20px;left:20px;background:var(--card);backdrop-filter:blur(10px);padding:8px 16px;border-radius:20px;font-weight:700;font-size:.9rem}
  .open{border:1px solid var(--green);color:var(--green)}
  .closed{border:1px solid #ff1744;color:#ff1744}
  .cart-btn{position:fixed;top:20px;right:20px;background:var(--card);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2);color:white;padding:12px 20px;border-radius:50px;cursor:pointer;z-index:100;font-weight:700;box-shadow:0 5px 20px rgba(0,0,0,0.3)}
  .cart-count{background:var(--pink);border-radius:50%;padding:3px 8px;font-size:.8rem;margin-left:6px}
  .container{max-width:750px;margin:-40px auto 0;padding:0 20px}
  .promo-banner{background:linear-gradient(90deg,#ff2d75,#7b2ff7);padding:15px;border-radius:18px;text-align:center;margin:25px 0;font-weight:800;font-size:1.1rem;box-shadow:0 8px 25px rgba(255,45,117,0.4);animation:pulse 2s infinite}
    @keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.02)}}
  .glass{background:var(--card);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:24px;padding:30px;margin:25px 0;box-shadow:0 8px 32px rgba(0,0,0,0.4)}
  .section-title{font-size:1.8rem;margin:35px 0 20px;background:linear-gradient(90deg,var(--pink),var(--purple));-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:800}
  .menu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
  .item{background:var(--card);backdrop-filter:blur(15px);border:1px solid rgba(255,255,255,0.1);border-radius:22px;padding:0;cursor:pointer;transition:.4s;overflow:hidden}
  .item:hover{transform:translateY(-8px);border-color:var(--pink);box-shadow:0 15px 40px rgba(255,45,117,0.3)}
  .milktea-icon{height:220px;display:flex;align-items:center;justify-content:center;font-size:7rem;position:relative}
  .milktea-icon::before{content:'🧋';filter:drop-shadow(0 5px 15px rgba(0,0,0,0.4));z-index:2}
  .okinawa{background:linear-gradient(135deg,#8B4513,#D2691E)}
  .thai{background:linear-gradient(135deg,#FF8C00,#FFA500)}
  .choco{background:linear-gradient(135deg,#3E2723,#5D4037)}
  .berry{background:linear-gradient(135deg,#E91E63,#F06292)}
  .item-badge{position:absolute;top:15px;right:15px;background:var(--pink);color:white;font-size:.75rem;padding:6px 14px;border-radius:20px;font-weight:700;box-shadow:0 4px 15px rgba(255,45,117,0.5);z-index:3}
  .item-content{padding:20px;position:relative}
  .item-header{display:flex;justify-content:space-between;align-items:start;margin-bottom:10px}
  .item h3{font-size:1.4rem;font-weight:700}
  .item p{color:var(--muted);font-size:.95rem;margin-bottom:15px;line-height:1.5}
  .price{color:var(--pink);font-weight:800;font-size:1.6rem;text-shadow:0 0 15px rgba(255,45,117,0.6)}
  .add-btn{background:linear-gradient(135deg,var(--pink),var(--purple));color:white;border:none;padding:12px;border-radius:15px;cursor:pointer;font-weight:700;width:100%;font-size:1rem;box-shadow:0 5px 20px rgba(255,45,117,0.4)}
  .option-group{margin:20px 0}
  .option-title{font-weight:700;margin-bottom:12px;color:var(--pink)}
  .option-buttons{display:grid;grid-template-columns:repeat(auto-fit,minmax(80px,1fr));gap:10px}
  .option-btn{background:var(--card);border:2px solid rgba(255,255,255,0.1);border-radius:15px;padding:12px 8px;cursor:pointer;transition:.3s;text-align:center;font-weight:600;font-size:.9rem}
  .option-btn.selected{border-color:var(--pink);background:rgba(255,45,117,0.15);box-shadow:0 0 20px rgba(255,45,117,0.3);transform:scale(1.05)}
  .sinker-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
  .sinker-item{background:var(--card);border:2px solid rgba(255,255,255,0.1);border-radius:18px;padding:18px 10px;text-align:center;cursor:pointer;transition:.3s}
  .sinker-item.selected{border-color:var(--pink);background:rgba(255,45,117,0.15);box-shadow:0 0 20px rgba(255,45,117,0.3);transform:scale(1.05)}
  .sinker-item.emoji{font-size:3rem;margin-bottom:8px}
  .sinker-item p{font-size:.9rem;font-weight:700;margin-bottom:4px}
  .sinker-item span{font-size:.8rem;color:var(--pink);font-weight:600}
  .cart-modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);backdrop-filter:blur(8px);z-index:200;justify-content:center;align-items:center}
  .cart-content{background:var(--bg);border:1px solid rgba(255,255,255,0.2);border-radius:28px;padding:35px;width:90%;max-width:550px;max-height:85vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,0.5)}
  .cart-item{padding:15px 0;border-bottom:1px solid rgba(255,255,255,0.1)}
  .cart-item-main{display:flex;justify-content:space-between;font-weight:600}
  .cart-details{font-size:.85rem;color:var(--muted);margin-top:6px}
  .delivery-select{width:100%;padding:12px;background:var(--card);border:1px solid rgba(255,255,255,0.2);border-radius:15px;color:white;font-size:1rem;margin:15px 0}
  .btn{background:linear-gradient(135deg,var(--pink),var(--purple));color:white;padding:16px;border:none;width:100%;border-radius:18px;font-size:1.15rem;font-weight:800;cursor:pointer;margin-top:20px;box-shadow:0 8px 25px rgba(255,45,117,0.5)}
  .btn:disabled{background:#444;cursor:not-allowed;box-shadow:none}
  .close-btn{background:rgba(255,255,255,0.1);border:none;color:white;padding:10px 18px;border-radius:15px;float:right;cursor:pointer;font-weight:600}
  .footer{text-align:center;padding:50px 20px;color:var(--muted)}
  .qr-modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);z-index:300;justify-content:center;align-items:center}
  .qr-content{background:white;border-radius:20px;padding:30px;text-align:center;color:#000;max-width:350px}
  </style>
</head>
<body>
  <div class="store-status open" id="storeStatus">🟢 OPEN 10AM-9PM</div>
  <button class="cart-btn" onclick="openCart()">🛒 Cart <span class="cart-count" id="cartCount">0</span></button>
  <div class="header">
    <h1>TeaKoTo 🧋</h1>
    <p>Premium Milk Tea Experience</p>
    <p>📍 Langkiwa, Biñan City | ⏰ 10AM - 9PM</p>
  </div>
  <div class="container">
    <div class="promo-banner" id="promoBanner">🎉 WEDNESDAY MADNESS: Buy 2 Get 1 Free! 🎉</div>

    <h2 class="section-title">🔥 Signature Blends</h2>
    <div class="menu-grid">
      <div class="item" onclick="selectDrink('Okinawa Royale',55)">
        <div class="milktea-icon okinawa"></div>
        <div class="item-badge">BEST SELLER</div>
        <div class="item-content">
          <div class="item-header"><h3>Okinawa Royale</h3><div class="price">₱55</div></div>
          <p>Premium brown sugar + fresh Hokkaido milk + extra chewy pearls</p>
          <button class="add-btn">Customize Order</button>
        </div>
      </div>
      <div class="item" onclick="selectDrink('Thai Supreme',59)">
        <div class="milktea-icon thai"></div>
        <div class="item-badge">NEW</div>
        <div class="item-content">
          <div class="item-header"><h3>Thai Supreme</h3><div class="price">₱59</div></div>
          <p>Authentic Thai tea leaves + condensed milk + aromatic spices</p>
          <button class="add-btn">Customize Order</button>
        </div>
      </div>
      <div class="item" onclick="selectDrink('Belgian Dark Choco',65)">
        <div class="milktea-icon choco"></div>
        <div class="item-content">
          <div class="item-header"><h3>Belgian Dark Choco</h3><div class="price">₱65</div></div>
          <p>70% Belgian dark chocolate + cream cheese cloud foam</p>
          <button class="add-btn">Customize Order</button>
        </div>
      </div>
      <div class="item" onclick="selectDrink('Berry Cheesecake',69)">
        <div class="milktea-icon berry"></div>
        <div class="item-content">
          <div class="item-header"><h3>Berry Cheesecake</h3><div class="price">₱69</div></div>
          <p>Fresh strawberry puree + NY cheesecake + graham crumbs</p>
          <button class="add-btn">Customize Order</button>
        </div>
      </div>
    </div>

    <div class="glass" id="customizeSection" style="display:none">
      <h2 class="section-title" style="margin-top:0">✨ Customize Your Drink</h2>

      <div class="option-group">
        <div class="option-title">📏 Size</div>
        <div class="option-buttons">
          <div class="option-btn selected" onclick="setOption('size','Regular',0,this)">Regular<br>₱0</div>
          <div class="option-btn" onclick="setOption('size','Large',15,this)">Large<br>+₱15</div>
        </div>
      </div>

      <div class="option-group">
        <div class="option-title">🍬 Sugar Level</div>
        <div class="option-buttons">
          <div class="option-btn" onclick="setOption('sugar','0%',0,this)">0%</div>
          <div class="option-btn" onclick="setOption('sugar','25%',0,this)">25%</div>
          <div class="option-btn" onclick="setOption('sugar','50%',0,this)">50%</div>
          <div class="option-btn selected" onclick="setOption('sugar','100%',0,this)">100%</div>
        </div>
      </div>

      <div class="option-group">
        <div class="option-title">🧊 Ice Level</div>
        <div class="option-buttons">
          <div class="option-btn" onclick="setOption('ice','No Ice',0,this)">No Ice</div>
          <div class="option-btn" onclick="setOption('ice','Less Ice',0,this)">Less</div>
          <div class="option-btn selected" onclick="setOption('ice','Normal',0,this)">Normal</div>
        </div>
      </div>

      <div class="option-group">
        <div class="option-title">➕ Add Sinkers +₱15 each</div>
        <div class="sinker-grid">
          <div class="sinker-item" onclick="toggleSinker('Pearls',15,this)"><div class="emoji">⚫</div><p>Pearls</p><span>+₱15</span></div>
          <div class="sinker-item" onclick="toggleSinker('Nata',15,this)"><div class="emoji">⬜</div><p>Nata</p><span>+₱15</span></div>
          <div class="sinker-item" onclick="toggleSinker('Pudding',15,this)"><div class="emoji">🍮</div><p>Pudding</p><span>+₱15</span></div>
          <div class="sinker-item" onclick="toggleSinker('Coffee Jelly',15,this)"><div class="emoji">☕</div><p>Coffee Jelly</p><span>+₱15</span></div>
          <div class="sinker-item" onclick="toggleSinker('Cream Cheese',15,this)"><div class="emoji">🧀</div><p>Cream Cheese</p><span>+₱15</span></div>
          <div class="sinker-item" onclick="toggleSinker('Oreo',15,this)"><div class="emoji">🍪</div><p>Oreo</p><span>+₱15</span></div>
        </div>
      </div>

      <p style="text-align:center;margin-top:20px;color:var(--muted);font-weight:600;">Selected: <span id="selectedOptions" style="color:var(--pink);">None</span></p>
      <button class="btn" onclick="addToCartWithOptions()">Add to Cart - ₱<span id="currentPrice">0</span></button>
    </div>
  </div>

  <div class="cart-modal" id="cartModal">
    <div class="cart-content">
      <button class="close-btn" onclick="closeCart()">✕</button>
      <h2 style="margin-bottom:25px;font-weight:800;">Your Order 🧋</h2>
      <div id="cartItems"></div>

      <div class="option-group">
        <div class="option-title">🚚 Delivery Location</div>
        <select class="delivery-select" id="deliveryArea" onchange="updateCartDisplay()">
          <option value="0">Pickup - Langkiwa (₱0)</option>
          <option value="20">Langkiwa (₱20)</option>
          <option value="30">Timbao (₱30)</option>
          <option value="40">Malaban (₱40)</option>
          <option value="50">Biñan Bayan (₱50)</option>
          <option value="60">San Antonio (₱60)</option>
        </select>
      </div>

      <div style="border-top:2px solid var(--pink);margin:25px 0;padding-top:20px;">
        <h3 style="font-size:1.2rem;margin-bottom:10px;">Subtotal: ₱<span id="subtotal">0</span></h3>
        <h3 style="font-size:1.2rem;margin-bottom:10px;">Delivery: ₱<span id="deliveryFee">0</span></h3>
        <h3 style="font-size:1.8rem;font-weight:800;">Total: ₱<span id="cartTotal">0</span></h3>
      </div>
      <button class="btn" onclick="showQR()">Pay via GCash QR 📱</button>
      <button class="btn" onclick="checkout()" style="background:rgba(255,255,255,0.1);margin-top:10px;">Checkout via Messenger 📩</button>
    </div>
  </div>

  <div class="qr-modal" id="qrModal">
    <div class="qr-content">
      <h2 style="margin-bottom:15px;">Scan to Pay</h2>
      <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=00020101021127770009PH.GCASH01119123456789" alt="GCash QR" style="width:100%;border-radius:15px;margin:15px 0">
      <p style="font-size:.9rem;color:#666;">GCash:09483132031</p>
      <p style="font-size:.9rem;color:#666;margin-top:5px;">Amount: ₱<span id="qrAmount">0</span></p>
      <button class="btn" onclick="closeQR()" style="background:#666;margin-top:15px;">Close</button>
    </div>
  </div>

  <div class="footer">
    <p>GCash: 09483132031 | We Deliver around Langkiwa & Biñan!</p>
    <p style="margin-top:15px;">© 2026 TeaKoTo Langkiwa | Crafted by Website Creator 🔥</p>
  </div>

  <script>
    let cart=[];let currentDrink=null;let selectedSinkers=[];
    let currentOptions={size:{name:'Regular',price:0},sugar:{name:'100%',price:0},ice:{name:'Normal',price:0}};
    let isStoreOpen=true;

    function updatePromo(){
      let day = new Date().getDay();
      let promos = [
        '🎉 SUNDAY FUNDAY: Buy 3 Get 1 Free! 🎉',
        '🎉 MONDAY MADNESS: 20% Off Thai Supreme! 🎉',
        '🎉 TUESDAY TREAT: Free Sinkers All Day! 🎉',
        '🎉 WEDNESDAY MADNESS: Buy 2 Get 1 Free! 🎉',
        '🎉 THURSDAY THIRST: ₱10 Off Large Size! 🎉',
        '🎉 FRIDAY FEELS: Free Delivery Langkiwa! 🎉',
        '🎉 SATURDAY SPECIAL: Berry Cheesecake ₱59 Only! 🎉'
      ];
      document.getElementById('promoBanner').innerHTML = promos[day];
    }
    updatePromo();

    function selectDrink(name,price){
      currentDrink={name,price};
      selectedSinkers=[];
      currentOptions={size:{name:'Regular',price:0},sugar:{name:'100%',price:0},ice:{name:'Normal',price:0}};
      document.querySelectorAll('.sinker-item').forEach(el=>el.classList.remove('selected'));
      document.querySelectorAll('.option-btn').forEach(el=>el.classList.remove('selected'));
      document.querySelectorAll('.option-btn')[0].classList.add('selected');
      document.querySelectorAll('.option-btn')[4].classList.add('selected');
      document.querySelectorAll('.option-btn')[7].classList.add('selected');
      document.getElementById('customizeSection').style.display='block';
      updatePrice();
      window.scrollTo({top:document.getElementById('customizeSection').offsetTop-100,behavior:'smooth'});
    }

    function setOption(type,name,price,el){
      currentOptions[type] = {name,price};
      el.parentElement.querySelectorAll('.option-btn').forEach(btn=>btn.classList.remove('selected'));
      el.classList.add('selected');
      updatePrice();
    }

    function toggleSinker(name,price,el){
      if(!currentDrink){alert('Pili ka muna ng drink tol 😅');return}
      el.classList.toggle('selected');
      let index=selectedSinkers.findIndex(s=>s.name===name);
      if(index>-1){selectedSinkers.splice(index,1)}else{selectedSinkers.push({name,price})}
      updatePrice();
    }

    function updatePrice(){
      if(!currentDrink){document.getElementById('currentPrice').innerText=0;return}
      let basePrice = currentDrink.price;
      let sizePrice = currentOptions.size.price;
      let sinkerTotal = selectedSinkers.reduce((sum,s)=>sum+s.price,0);
      let total = basePrice + sizePrice + sinkerTotal;
      document.getElementById('currentPrice').innerText = total;

      let optionsText = `${currentOptions.size.name}, ${currentOptions.sugar.name} Sugar, ${currentOptions.ice.name} Ice`;
      let sinkerText = selectedSinkers.length>0? selectedSinkers.map(s=>s.name).join(', ') : 'No sinkers';
      document.getElementById('selectedOptions').innerText = `${optionsText} | ${sinkerText}`;
    }

    function addToCartWithOptions(){
      if(!currentDrink){alert('Pili ka muna ng drink tol 😅');return}
      let sinkerTotal = selectedSinkers.reduce((sum,s)=>sum+s.price,0);
      let totalPrice = currentDrink.price + currentOptions.size.price + sinkerTotal;
      let sinkerNames = selectedSinkers.map(s=>s.name).join(', ') || 'No sinkers';
      let details = `${currentOptions.size.name}, ${currentOptions.sugar.name} Sugar, ${currentOptions.ice.name} Ice | ${sinkerNames}`;

      cart.push({
        name: currentDrink.name,
        price: totalPrice,
        details: details
      });
      updateCartCount();

      let toast=document.createElement('div');
      toast.innerHTML=`✅ ${currentDrink.name} added!`;
      toast.style.cssText='position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#ff2d75,#7b2ff7);color:white;padding:14px 28px;border-radius:30px;z-index:300;font-weight:700;box-shadow:0 8px 25px rgba(255,45,117,0.5);';
      document.body.appendChild(toast);
      setTimeout(()=>toast.remove(),2000);

      currentDrink=null;
      selectedSinkers=[];
      document.getElementById('customizeSection').style.display='none';
    }

    function updateCartCount(){document.getElementById('cartCount').innerText=cart.length}

    function updateCartDisplay(){
      let itemsDiv=document.getElementById('cartItems');
      let subtotal=0;
      itemsDiv.innerHTML='';
      if(cart.length===0){
        itemsDiv.innerHTML='<p style="text-align:center;color:#999;padding:20px;">Empty pa cart mo tol 😅</p>';
      }else{
        cart.forEach((item,i)=>{
          subtotal+=item.price;
          itemsDiv.innerHTML+=`<div class="cart-item"><div class="cart-item-main"><span>${item.name}</span><span>₱${item.price} <button onclick="removeItem(${i})" style="background:none;border:none;color:#ff2d75;cursor:pointer;font-size:1.2rem;">🗑️</button></span></div><div class="cart-details">${item.details}</div></div>`;
        });
      }
      let deliveryFee = parseInt(document.getElementById('deliveryArea').value);
      document.getElementById('subtotal').innerText = subtotal;
      document.getElementById('deliveryFee').innerText = deliveryFee;
      document.getElementById('cartTotal').innerText = subtotal + deliveryFee;
      document.getElementById('qrAmount').innerText = subtotal + deliveryFee;
    }

    function openCart(){
      updateCartDisplay();
      document.getElementById('cartModal').style.display='flex';
    }

    function removeItem(index){cart.splice(index,1);updateCartCount();updateCartDisplay()}
    function closeCart(){document.getElementById('cartModal').style.display='none'}

    function showQR(){
      if(cart.length===0){alert('Wala ka pang order tol 😅');return}
      updateCartDisplay();
      document.getElementById('qrModal').style.display='flex';
    }

    function closeQR(){document.getElementById('qrModal').style.display='none'}

    function checkout(){
      if(cart.length===0){alert('Wala ka pang order tol 😅');return}
      let deliveryFee = parseInt(document.getElementById('deliveryArea').value);
      let deliveryText = document.getElementById('deliveryArea').options[document.getElementById('deliveryArea').selectedIndex].text;
      let subtotal = cart.reduce((sum,item)=>sum+item.price,0);
      let total = subtotal + deliveryFee;
      let orderList = cart.map(i=>`• ${i.name} (₱${i.price})%0A ${i.details}`).join('%0A');
      let msg = `Hi TeaKoTo! Order ko:%0A%0A${orderList}%0A%0ASubtotal: ₱${subtotal}%0ADelivery: ₱${deliveryFee} (${deliveryText})%0ATotal: ₱${total}%0A%0APA-DELIVER PO!`;
      window.open(`https://m.me/61582448154635?text=${msg}`, '_blank');
      cart=[];updateCartCount();closeCart();
    }
  </script>
</body>
</html>
